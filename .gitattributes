# Everything ships with LF. A plugin's own hook scripts are executed by bash,
# where CRLF breaks the shebang line, and this repo must never hand one back
# with the wrong endings (CASE-02/03).
* text=auto eol=lf

# run-hook.cmd is a cmd.exe/bash polyglot; cmd.exe must not see a BOM or CRLF.
hooks/run-hook.cmd text eol=lf
