{
  "description": "win-hooks: repairs Codex plugin hooks for Windows",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/win-hooks\" heal codex --announce",
            "commandWindows": "cmd /c \"${PLUGIN_ROOT}\\hooks\\run-hook.cmd\" win-hooks heal codex --announce",
            "timeout": 60,
            "statusMessage": "win-hooks: checking Codex plugin hooks"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/win-hooks\" heal codex --changed-only",
            "commandWindows": "cmd /c \"${PLUGIN_ROOT}\\hooks\\run-hook.cmd\" win-hooks heal codex --changed-only",
            "timeout": 20,
            "statusMessage": "win-hooks: checking changed Codex plugin hooks"
          }
        ]
      }
    ]
  }
}
